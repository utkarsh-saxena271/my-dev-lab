generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model users {
  id         Int       @id     @default(autoincrement())
  username   String    @unique @db.VarChar(50)
  email      String    @unique @db.VarChar(255)
  password   String    @db.VarChar(255)
}

model todo{
  id     Int    @id @default(autoincrement())
  title  String     
  done   Boolean    
  userId Int 
}
